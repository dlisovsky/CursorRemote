# Cursor SDK
CURSOR_API_KEY=cursor_your_key_here
CURSOR_MODEL=composer-2.5

# Backend
PORT=3847
JWT_SECRET=change-me-in-production
MOCK_TG=true

# Comma-separated absolute paths to git repos (one path per project)
PROJECT_PATHS=/Users/you/dev/CursorRemote,/Users/you/dev/my-other-app

# Public HTTPS URL (Cloudflare tunnel) for Telegram Mini App
PUBLIC_URL=https://cursorremote.yourdomain.com

# Telegram bot token (for real initData HMAC validation)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=YourBot
TELEGRAM_MENU_LABEL=CursorRemote

# TMA (Vite) — test in Chrome without Telegram
VITE_MOCK_TG=true

# Voice transcription (faster-whisper via scripts/transcribe-voice.py)
TRANSCRIBE_MODEL=tiny
TRANSCRIBE_LANGUAGES=en,ru
# Defaults to ~/.cursor-remote-transcribe/bin/python when present
TRANSCRIBE_PYTHON=/Users/you/.cursor-remote-transcribe/bin/python
VOICE_ENABLED=true

# Photo attachments
PHOTOS_ENABLED=true
PHOTO_MAX_COUNT=4
PHOTO_MAX_BYTES=5242880

# Production Telegram: MOCK_TG=false, npm run tunnel, set BotFather Web App URL to PUBLIC_URL
