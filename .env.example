# Cursor SDK
CURSOR_API_KEY=cursor_your_key_here
CURSOR_MODEL=composer-2.5

# Backend
PORT=3847
JWT_SECRET=change-me-in-production
MOCK_TG=true

# Comma-separated absolute paths to git repos
PROJECT_PATHS=/Users/you/dev/CursorRemote

# Telegram bot token (for real initData HMAC validation)
TELEGRAM_BOT_TOKEN=

# TMA (Vite) — test in Chrome without Telegram
VITE_MOCK_TG=true

# Production Telegram: set MOCK_TG=false, expose PORT via HTTPS (ngrok), configure BotFather Web App URL
