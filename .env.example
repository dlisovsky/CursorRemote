# Cursor SDK
CURSOR_API_KEY=cursor_your_key_here
CURSOR_MODEL=composer-2.5

# Backend
PORT=3847
JWT_SECRET=change-me-in-production
MOCK_TG=true

# Comma-separated absolute paths to git repos (one path per project)
PROJECT_PATHS=/Users/you/dev/CursorRemote,/Users/you/dev/my-other-app

# Public HTTPS URL (Cloudflare tunnel) for Telegram Mini App
PUBLIC_URL=https://cursorremote.yourdomain.com

# Telegram bot token (for real initData HMAC validation)
TELEGRAM_BOT_TOKEN=

# TMA (Vite) — test in Chrome without Telegram
VITE_MOCK_TG=true

# Production Telegram: MOCK_TG=false, npm run tunnel, set BotFather Web App URL to PUBLIC_URL
