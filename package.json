{
  "name": "cursor-remote",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sdk:smoke": "tsx scripts/sdk-smoke-test.ts",
    "sdk:list": "tsx scripts/sdk-list-agents.ts",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:chrome:server": "MOCK_TG=true tsx watch server/src/index.ts",
    "dev:tma": "vite --config tma/vite.config.ts",
    "dev:chrome": "MOCK_TG=true VITE_MOCK_TG=true VITE_FORCE_TG_UI=true vite --config tma/vite.config.ts",
    "build:tma": "vite build --config tma/vite.config.ts",
    "watch:tma": "vite build --config tma/vite.config.ts --watch",
    "tunnel": "cloudflared tunnel --config .cloudflared/cursorremote.yml run",
    "preview:sync": "npm run build:tma",
    "dev:all": "bash scripts/dev-all.sh",
    "dev:telegram": "npm run build:tma && npm run dev:server",
    "setup:telegram": "bash scripts/setup-telegram.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.18",
    "@fontsource/geist-sans": "^5.2.5",
    "@mantine/core": "^9.3.1",
    "@mantine/hooks": "^9.3.1",
    "@mantine/modals": "^9.3.1",
    "@mantine/notifications": "^9.3.1",
    "@tabler/icons-react": "^3.44.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.4.1",
    "dotenv": "^16.4.7",
    "postcss": "^8.5.15",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.8"
  }
}
